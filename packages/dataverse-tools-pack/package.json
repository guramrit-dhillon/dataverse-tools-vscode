{
  "name": "dataverse-tools-pack",
  "repository": {
    "type": "git",
    "url": "https://github.com/guramrit-dhillon/dataverse-tools-vscode.git"
  },
  "license": "MIT",
  "displayName": "Dataverse Tools",
  "description": "Complete Dataverse development toolkit for VS Code — manage plugins, browse metadata, query data, edit web resources, manage workflows, and more",
  "version": "0.6.0",
  "publisher": "gdhillon",
  "homepage": "https://github.com/guramrit-dhillon/dataverse-tools-vscode#readme",
  "bugs": {
    "url": "https://github.com/guramrit-dhillon/dataverse-tools-vscode/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Extension Packs"
  ],
  "keywords": [
    "dataverse",
    "power platform",
    "dynamics 365",
    "crm",
    "plugin",
    "metadata",
    "workflow",
    "fetchxml",
    "sql",
    "web resources",
    "audit",
    "assembly"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "icon": "resources/icon.png",
  "extensionPack": [
    "gdhillon.dataverse-environments",
    "gdhillon.dataverse-assemblies",
    "gdhillon.dataverse-metadata",
    "gdhillon.dataverse-plugin-trace-viewer",
    "gdhillon.fetchxml-builder",
    "gdhillon.dataverse-query-analyzer",
    "gdhillon.dataverse-workflows",
    "gdhillon.dataverse-web-resources",
    "gdhillon.dataverse-assembly-decompiler",
    "gdhillon.dataverse-audit-viewer"
  ],
  "scripts": {
    "build": "echo 'No build step for extension pack'",
    "package": "npx @vscode/vsce package --no-dependencies -o out/",
    "package:prerelease": "npx @vscode/vsce package --no-dependencies --pre-release -o out/"
  }
}
